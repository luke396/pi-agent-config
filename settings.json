{
  "theme": "catppuccin-tui-mocha",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "only"
  },
  "modelThinkingLevels": {
    "openai/gpt-6-astra": "max",
    "openai/gpt-6.1-sol": "max"
  },
  "showCacheMissNotices": true,
  "tuiMode": "regular",
  "terminal": {
    "images": "kitty"
  },
  "subagents": {
    "watchdog": {
      "enabled": true
    }
  },
  "skills": [],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    {
      "source": "git:github.com/mattpocock/skills",
      "skills": [
        "skills/engineering/**",
        "skills/productivity/**"
      ]
    },
    "npm:pi-open-tui",
    {
      "source": "npm:pi-catppuccin-tui",
      "extensions": []
    },
    "npm:pi-vim",
    "npm:@mrclrchtr/supi-settings",
    "npm:@mrclrchtr/supi-skills"
  ]
}
