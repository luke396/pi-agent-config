{
  "theme": "catppuccin-tui-mocha",
  "defaultThinkingLevel": "max",
  "defaultTools": [
    "+codemode"
  ],
  "codemode": {
    "mode": "only"
  },
  "modelThinkingLevels": {
    "openai/gpt-6-astra": "max",
    "openai/gpt-6.1-sol": "max"
  },
  "showCacheMissNotices": false,
  "terminal": {
    "images": "kitty"
  },
  "subagents": {
    "watchdog": {
      "enabled": true
    }
  },
  "packages": [
    "npm:pi-web-access",
    "npm:pi-subagents",
    {
      "source": "git:github.com/mattpocock/skills",
      "skills": [
        "skills/engineering/**",
        "skills/productivity/**"
      ]
    },
    {
      "source": "npm:pi-catppuccin-tui",
      "extensions": []
    },
    "npm:pi-vim",
    "npm:@luan.sh/pi-collapse-transcript",
    "npm:@arhen/pi-core-tps-stats",
    "npm:@arhen/pi-core-ask",
    {
      "source": "npm:pi-hermes-memory@0.9.10",
      "extensions": []
    }
  ]
}
