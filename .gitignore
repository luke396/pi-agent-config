# --- Credentials (per-machine /login, never commit) ---
auth.json

# --- Provider definitions ---
# Machine-bound: gateway URL, quota group, model list. Decoupled from pi's own
# settings, so each machine keeps its own copy.
models.json

# --- Local project-trust decisions ---
# Security: syncing these would carry "I trusted this directory" approvals to
# other machines, i.e. auto-approve unknown directories there.
trust.json

# --- Sessions and runtime state (large, churning, regenerable) ---
sessions/
run-history.jsonl
*.log
*.bak
.DS_Store

# --- Caches and upstream-managed trees (rebuilt by pi install / pi update) ---
models-store.json
npm/
git/

# --- Machine-local artifacts ---
# missions/ subdirectories are named after a hash of the local project path,
# so syncing them only produces duplicates elsewhere.
missions/

# --- Omarchy-generated theme ---
# Rendered by Omarchy from $OMARCHY_PATH/default/themed/pi.json.tpl, so every
# Omarchy machine regenerates it on theme change. settings.json still names it;
# pi falls back to the default theme silently when the file is absent.
/themes/omarchy-system.json

# --- Files owned by third-party tools; each machine installs them itself ---
# herdr overwrites this file whenever its integration is (re)installed.
extensions/herdr-agent-state.ts
# Omarchy installer symlinks targeting /usr/share/omarchy/... would dangle on
# machines that do not have Omarchy.
skills/diagnose-crash
skills/omarchy
