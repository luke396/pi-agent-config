# --- Credentials (per-machine /login, never commit) ---
auth.json
# Pi's MCP OAuth tokens are also per-machine credentials.
/mcp-auth.json
# pi-web-access reads its config from $XDG_CONFIG_HOME/pi/web-search.json, or
# from this directory when XDG_CONFIG_HOME is unset. Its text *is* the secret
# (API keys), so the fallback path must never be committable. Root-anchored so
# nothing nested is swallowed.
/web-search.json

# --- Provider definitions ---
# Machine-bound: gateway URL, quota group, model list. Decoupled from pi's own
# settings, so each machine keeps its own copy.
models.json

# --- Local project-trust decisions ---
# Security: syncing these would carry "I trusted this directory" approvals to
# other machines, i.e. auto-approve unknown directories there.
trust.json

# --- Sessions and runtime state (large, churning, regenerable) ---
sessions/
run-history.jsonl
# pi-config-sync clean/smudge filter and this machine's settings fields.
# Includes defaultProvider/defaultModel: choices depend on local models/auth.
/.git-sync/
# pi-subagents upgrade-notice state, recorded independently on each machine.
/pi-subagents/last-seen-version.json
# Per-machine preference store, e.g. the toggle pi-codex-fast-mode wrote
# before it was uninstalled. Root-anchored: a nested state/ dir is not ours.
/state/
*.log
*.bak
*.bak-*
*.bak_*
.DS_Store

# --- Caches and upstream-managed trees (rebuilt by pi install / pi update) ---
models-store.json
# pi-web-access fetched page content; private, short-lived, machine-local.
/web-search-cache/
npm/
git/

# --- Machine-local artifacts ---
# missions/ subdirectories are named after a hash of the local project path,
# so syncing them only produces duplicates elsewhere.
missions/

# --- Machine-local scratch and manual backups ---
/tmp/
/backups/

# --- Omarchy-generated theme ---
# Rendered by Omarchy from $OMARCHY_PATH/default/themed/pi.json.tpl, so every
# Omarchy machine regenerates it on theme change.
/themes/omarchy-system.json

# --- Files owned by third-party tools; each machine installs them itself ---
# herdr overwrites this file whenever its integration is (re)installed.
extensions/herdr-agent-state.ts
# Omarchy installer symlinks targeting /usr/share/omarchy/... would dangle on
# machines that do not have Omarchy.
skills/diagnose-crash
skills/omarchy
# `lark-cli install` fetches these from open.feishu.cn, digest-locks them in
# ~/.agents/.skill-lock.json and symlinks them in from ~/.agents/skills/. That
# lockfile lives outside this repo, so a tracked copy here would be a second,
# silently diverging version of a remote-owned skill — and a dangling symlink
# (mode 120000) on machines that never ran the installer. Root-anchored: they
# are top-level skills, and nothing nested is ours.
/skills/lark-*
